# Copia este archivo a .env y completa los valores reales.

# Postgres
DATABASE_URL="postgresql://usuario:password@localhost:5432/VitalGuard?schema=public"
SHADOW_DATABASE_URL="postgresql://usuario:password@localhost:5432/VitalGuardShadow?schema=public"

# Puerto HTTP del servicio
PORT=3001

# Requerido: sin él la app no arranca (ver src/common/config/jwt-secret.ts)
JWT_SECRET=""

# Broker MQTT para comunicación con los dispositivos ESP32 (pastillero)
MQTT_BROKER_URL="mqtt://localhost:1883"

# IA (Gemini) para comandos de voz de Alexa
GEMINI_API_KEY=""
# Verifica que el modelo exista en la API de Google antes de desplegar.
GEMINI_MODEL=""

# Correo transaccional vía Resend (invitaciones a cuidadores/médicos)
RESEND_API_KEY=""
MAIL_FROM="VitalGuard <no-reply@vitalguard.app>"
INVITE_BASE_URL="https://vitalguard.app/invite"

# Firebase Cloud Messaging (push móvil)
FIREBASE_SERVICE_ACCOUNT_PATH="./secrets/firebase-service-account.json"
FIREBASE_SERVICE_ACCOUNT=""

# Vital ID (Authorization Server / SSO). NOTA: existen dos variables para la
# URL de Vital ID usadas en distintos módulos (inconsistencia conocida, no
# unificada todavía) — hay que definir ambas con el mismo valor:
VITAL_ID_BASE_URL="http://localhost:3000"
VITAL_ID_API_URL="http://localhost:3000"
VITAL_ID_TIMEOUT_MS=5000
# Clave compartida para llamar a Vital ID GET /auth/user/:id.
# Debe coincidir con INTERNAL_SERVICE_KEY en el .env de VitalID API.
INTERNAL_SERVICE_KEY=""

# Alexa Skill (account linking / validación de requests)
ALEXA_SKILL_ID=""
ALEXA_INTENT_NAME="FraseLibreIntent"
ALEXA_TEXT_SLOT_NAME="texto"

# development | production
NODE_ENV="development"

# Rate limiting (opcional, valores por defecto en el guard si se omiten)
# RATE_LIMIT_ALEXA_LIMIT=30
# RATE_LIMIT_ALEXA_WINDOW_MS=60000
# RATE_LIMIT_VOICE_COMMAND_LIMIT=20
# RATE_LIMIT_VOICE_COMMAND_WINDOW_MS=60000
